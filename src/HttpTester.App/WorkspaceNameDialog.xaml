<Window Icon="Assets/HttpDetector.ico" x:Class="HttpTester.App.WorkspaceNameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="24">
  <TextBlock Text="工作区名称" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBox x:Name="WorkspaceName" MaxLength="40" AutomationProperties.Name="工作区名称"/>
  <TextBlock Text="请求按工作区独立保存，名称最多 40 个字符。" Foreground="#7C8B9C" FontSize="12" Margin="0,10,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></StackPanel>
 </StackPanel>
</Window>
