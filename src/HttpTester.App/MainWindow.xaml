<Window Icon="Assets/HttpDetector.ico" x:Class="HttpTester.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HttpTester.App.Controls" Title="Http探测器 · 轻量接口测试" Width="1240" Height="840" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EDF2F7" BorderBrush="#DFE6EF" BorderThickness="0,0,1,0">
   <Grid Margin="18,22,18,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,23"><StackPanel Orientation="Horizontal"><Image Source="Assets/HttpDetector.png" Width="42" Height="42" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel><TextBlock Text="Http探测器" FontSize="20" FontWeight="SemiBold" Foreground="#172C43"/><TextBlock Text="轻装上阵，即刻调试" FontSize="11" Foreground="#7C8B9C" Margin="0,3,0,0"/></StackPanel></StackPanel></StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="工作区" Foreground="#6D7E93" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,7"/>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="WorkspaceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Workspace_Changed" AutomationProperties.Name="当前工作区" ToolTip="切换工作区；请求按工作区独立保存"/>
      <Button x:Name="NewWorkspaceButton" Grid.Column="1" Content="＋" Padding="0" Margin="5,0,0,0" FontSize="17" Click="NewWorkspace_Click" ToolTip="新建工作区" AutomationProperties.Name="新建工作区"/>
      <Button x:Name="RenameWorkspaceButton" Grid.Column="2" Content="✎" Padding="0" Margin="5,0,0,0" FontSize="17" Click="RenameWorkspace_Click" ToolTip="重命名当前工作区" AutomationProperties.Name="重命名工作区"/>
     </Grid>
     <TextBlock Text="请求仅保存到当前工作区" Foreground="#8A96A7" FontSize="11" Margin="2,0,0,16"/>
     <Button x:Name="NewButton" Content="＋  新建请求" Click="New_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,15" ToolTip="Ctrl+N"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><Grid Margin="0,0,0,16"><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="按名称、地址或方法筛选" AutomationProperties.Name="搜索已保存请求"/><TextBlock Text="搜索名称或地址…" Foreground="#97A3B3" Margin="11,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><DockPanel Margin="3,0,3,9"><TextBlock Text="已保存请求" FontSize="11" FontWeight="SemiBold" Foreground="#7C8B9C"/><TextBlock x:Name="CountLabel" Text="0" HorizontalAlignment="Right" Foreground="#7C8B9C" FontSize="11"/></DockPanel></StackPanel>
    <ListBox x:Name="ProfileList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="Profile_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Background" Value="#E2EAF2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#D5EBEC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,6,0,0"><TextBlock Text="{Binding Method}" Foreground="#087F8C" FontSize="10" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" Foreground="#7C8B9C" FontSize="10"/></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Margin="0,12,0,0"><UniformGrid Columns="3"><Button Content="导入" Click="Import_Click" Padding="8,7" Margin="0,0,5,0"/><Button Content="导出" Click="Export_Click" Padding="8,7" Margin="0,0,5,0"/><Button Content="删除" Click="Delete_Click" Padding="8,7"/></UniformGrid><TextBlock Text="本地保存 · 无需登录" Foreground="#8A96A7" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="24,22,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="190"/><RowDefinition Height="12"/><RowDefinition Height="3*" MinHeight="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
    <StackPanel><DockPanel Margin="1,0,0,7"><TextBlock Text="请求名称" FontSize="12" Foreground="#52677F" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceHint" FontSize="11" Foreground="#8190A4" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBox x:Name="NameBox" Text="未命名请求" TextChanged="Editor_Changed" FontSize="17" FontWeight="SemiBold" Padding="11,8" BorderBrush="#BCCDDD" Background="White" AutomationProperties.Name="请求名称" ToolTip="填写请求名称，点击保存后可在左侧再次加载"/>
    </StackPanel><Button Grid.Column="1" Content="保存请求" Click="Save_Click" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="12,11" ToolTip="Ctrl+S · 保存到当前工作区"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="109"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><ComboBox x:Name="MethodBox" SelectionChanged="Editor_Changed" FontWeight="SemiBold" Foreground="#087F8C" AutomationProperties.Name="请求方法"/><TextBox Grid.Column="1" x:Name="UrlBox" TextChanged="Editor_Changed" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Margin="8,0" ToolTip="完整 URL，例如 https://httpbin.org/get" AutomationProperties.Name="请求地址"/><Button Grid.Column="2" x:Name="SendButton" Content="发送  ↗" Click="Send_Click" Style="{StaticResource PrimaryButton}" ToolTip="Ctrl+Enter · 发送；请求中点击取消"/></Grid>
   <DockPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="请求设置" Foreground="#718096" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="RedirectBox" Content="跟随重定向" IsChecked="True" Checked="Editor_Changed" Unchecked="Editor_Changed" Margin="0,0,18,0"/><TextBlock Text="超时" VerticalAlignment="Center" Foreground="#718096"/><TextBox x:Name="TimeoutBox" Text="30" Width="46" Padding="5,3" Margin="7,0" TextChanged="Editor_Changed" AutomationProperties.Name="超时秒数"/><TextBlock Text="秒" VerticalAlignment="Center" Foreground="#718096"/></StackPanel></DockPanel>
   <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#DFE6EF" BorderThickness="1" Padding="12,0,12,10">
    <TabControl x:Name="RequestTabs">
     <TabItem Header="查询参数"><DockPanel Margin="0,10,0,0"><DockPanel DockPanel.Dock="Bottom" Margin="3,8,0,0"><Button Content="＋ 添加参数" Tag="Query" Click="AddField_Click" Padding="8,4"/><TextBlock Text="单击输入框即可编辑；支持重复键，取消勾选可临时禁用。" Foreground="#8190A4" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel><DataGrid x:Name="QueryGrid" PreviewMouseLeftButtonDown="Grid_EditCell" AutomationProperties.Name="查询参数"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/><DataGridTextColumn Header="参数名（Key）· 单击填写" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/><DataGridTextColumn Header="参数值（Value）· 单击填写" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="请求头"><DockPanel Margin="0,10,0,0"><DockPanel DockPanel.Dock="Bottom" Margin="3,8,0,0"><Button Content="＋ 添加请求头" Tag="Headers" Click="AddField_Click" Padding="8,4"/><TextBlock Text="例如 Accept、Authorization、Cookie；Content-Type 自动设置，也可覆盖。" Foreground="#8190A4" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel><DataGrid x:Name="HeaderGrid" PreviewMouseLeftButtonDown="Grid_EditCell" AutomationProperties.Name="请求头"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/><DataGridTextColumn Header="请求头名称（Key）· 单击填写" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/><DataGridTextColumn Header="请求头值（Value）· 单击填写" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="请求体"><DockPanel Margin="0,10,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,9"><ComboBox x:Name="BodyKindBox" Width="180" HorizontalAlignment="Left" SelectionChanged="BodyKind_Changed" AutomationProperties.Name="请求体类型"/><Button x:Name="PickFileButton" Content="选择文件…" Click="PickFile_Click" Padding="10,5" HorizontalAlignment="Right" Visibility="Collapsed"/></DockPanel><Grid><TextBlock x:Name="NoBodyLabel" Text="此请求不发送请求体。" Foreground="#8A96A7" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="BodyEditor" AcceptsReturn="True" AcceptsTab="True" TextChanged="Editor_Changed" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="请求体内容"/><DockPanel x:Name="FormPanel" Visibility="Collapsed"><Button DockPanel.Dock="Bottom" Content="＋ 添加字段" Tag="Form" Click="AddField_Click" Padding="8,4" HorizontalAlignment="Left" Margin="3,8,0,0"/><DataGrid x:Name="FormGrid" PreviewMouseLeftButtonDown="Grid_EditCell" AutomationProperties.Name="表单字段"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/><DataGridTextColumn Header="字段名（Key）· 单击填写" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/><DataGridTextColumn Header="值 / 文件完整路径" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" CellStyle="{StaticResource EditableCell}" EditingElementStyle="{StaticResource CellEditor}"/><DataGridCheckBoxColumn x:Name="FileColumn" Header="文件" Binding="{Binding IsFile}" Width="50"/></DataGrid.Columns></DataGrid></DockPanel></Grid></DockPanel></TabItem>
     <TabItem Header="身份认证"><StackPanel Margin="3,12"><ComboBox x:Name="AuthKindBox" Width="180" HorizontalAlignment="Left" SelectionChanged="AuthKind_Changed" AutomationProperties.Name="认证方式"/><TextBox x:Name="TokenBox" Margin="0,12,0,0" TextChanged="Editor_Changed" Visibility="Collapsed" ToolTip="Bearer Token" AutomationProperties.Name="Bearer Token"/><Grid x:Name="BasicPanel" Visibility="Collapsed" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="UsernameBox" Margin="0,0,8,0" TextChanged="Editor_Changed" ToolTip="用户名" AutomationProperties.Name="用户名"/><TextBox Grid.Column="1" x:Name="PasswordBox" TextChanged="Editor_Changed" ToolTip="密码" AutomationProperties.Name="密码"/></Grid><TextBlock Text="认证信息随请求保存在本机。导出文件时也会包含，请妥善保管。" TextWrapping="Wrap" Foreground="#8A96A7" FontSize="11" Margin="0,13,0,0"/></StackPanel></TabItem>
    </TabControl>
   </Border>
   <GridSplitter Grid.Row="4" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>
   <Border Grid.Row="5" Background="White" CornerRadius="8" BorderBrush="#DFE6EF" BorderThickness="1" Padding="12,0,12,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="3,12,3,5"><TextBlock Text="响应" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border x:Name="StatusBadge" Background="#E6F4EF" CornerRadius="4" Padding="8,4" Visibility="Collapsed"><TextBlock x:Name="StatusLabel" Foreground="#177250" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock x:Name="MetricsLabel" Text="等待发送" VerticalAlignment="Center" Foreground="#8190A4" FontSize="11" Margin="12,0,0,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><TabControl x:Name="ResponseTabs"><TabItem Header="响应体"><DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="格式化 / 高亮 JSON" Click="Format_Click" Padding="10,4" Margin="0,0,6,0"/><Button Content="原始文本" Click="Raw_Click" Padding="10,4" Margin="0,0,6,0"/><Button Content="复制" Click="Copy_Click" Padding="10,4" Margin="0,0,6,0"/><Button Content="保存响应" Click="SaveResponse_Click" Padding="10,4" Margin="0,0,14,0"/><CheckBox x:Name="WrapBox" Content="自动换行" Checked="Wrap_Changed" Unchecked="Wrap_Changed"/></StackPanel><controls:JsonResponseView x:Name="ResponseBody" Background="#FAFBFD" Foreground="#25344A" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="响应体"/></DockPanel></TabItem><TabItem Header="响应头"><TextBox x:Name="ResponseHeaders" IsReadOnly="True" Background="#FAFBFD" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="响应头"/></TabItem></TabControl><StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"><TextBlock Text="↗" FontSize="36" Foreground="#B4D5D8" HorizontalAlignment="Center"/><TextBlock Text="准备好，发送第一个请求" Foreground="#718096" FontSize="15" Margin="0,8,0,5"/><TextBlock Text="Ctrl + Enter 发送  ·  Ctrl + S 保存" Foreground="#A0ABBA" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid>
    </Grid>
   </Border>
   <DockPanel Grid.Row="6" Margin="2,10,2,0"><TextBlock x:Name="FooterLabel" Text="就绪" Foreground="#718096" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="Http探测器  /  1.1" Foreground="#A0ABBA" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
</Window>
